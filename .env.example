# Optional server-only configuration. Values are not required in mock mode.
DEVLAB_ADAPTER_MODE=mock
DEVLAB_ROOT=
DEVLAB_API_URL=
DEVLAB_SUPABASE_URL=
# Local demo persistence; defaults to .studio
STUDIO_DATA_DIR=.studio
# Server-only authoritative CPE reads (never VITE_ variables).
DEVLAB_SUPABASE_SERVICE_ROLE_KEY=
DEVLAB_READ_PROJECT_SLUGS=
# Hosted API authorization and isolated shadow runner.
BRIDGE_OWNER_EMAIL=
BRIDGE_VIEWER_EMAILS=
BRIDGE_RUNNER_ID=hudson-mac-shadow
BRIDGE_RUNNER_TOKEN=
BRIDGE_OPERATOR_TOKEN=
# Local runner uses a chmod 600 JSON file; do not put these in browser storage.
BRIDGE_CONFIG=.studio/runner.json
BRIDGE_EXECUTOR_MODE=MOCK
